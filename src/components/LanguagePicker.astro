---
import * as messages from "@/paraglide/messages";
import { getLocales, useTranslations, type Locale } from "@/utils/locale";

type MsgKey = Exclude<keyof typeof messages, "m">;

const locales = getLocales();
const currentLocale = Astro.currentLocale as Locale;
const m = useTranslations(currentLocale);

type Props = {
  class?: string;
  availableLocales?: Locale[];
};
const { class: className, availableLocales } = Astro.props;
const displayLocales = availableLocales ?? locales;

const pathname = Astro.url.pathname;
const basePath = pathname.slice(`/${currentLocale}`.length) || "/";
---

<select
  name="language"
  id="language-picker"
  class={className}
  aria-label={m.text_select_language()}
>
  {
    displayLocales.map(locale => {
      const key = `lang_${locale.replace("-", "_").toLowerCase()}` as MsgKey;
      const mt = useTranslations(locale as Locale);
      return (
        <option value={locale} selected={locale === currentLocale}>
          {(mt[key] as () => string)()}
        </option>
      );
    })
  }
</select>

