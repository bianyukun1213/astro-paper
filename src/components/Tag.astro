---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "tw:flex tw:items-center tw:gap-0.5",
      "tw:border-b-2 tw:border-dashed tw:border-foreground",
      "tw:hover:-mt-0.5 tw:hover:border-accent tw:hover:text-accent",
      "tw:focus-visible:border-none tw:focus-visible:text-accent",
      { "tw:text-sm": size === "sm" },
      { "tw:text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "tw:opacity-80",
        { "tw:size-5": size === "lg" },
        { "tw:size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
