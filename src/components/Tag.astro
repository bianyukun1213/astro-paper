---
import IconHash from "@/assets/icons/IconHash.svg";
import { getLocalizedUrl, type Locale } from "@/utils/locale";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const currentLocale = Astro.currentLocale as Locale;
---

<li>
  <a
    href={getLocalizedUrl(currentLocale, `/tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "flex items-center gap-0.5",
      "border-b-2 border-dashed border-foreground",
      "hover:-mt-0.5 hover:border-accent hover:text-accent",
      "focus-visible:border-none focus-visible:text-accent",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
  <span class="p-category hidden">{tagName}</span>
</li>
