---
import { getPostsByLocale } from "@/utils/getPostsByLocale";
import getUniqueTags from "@/utils/getUniqueTags";
import { getLocalizedUrl, useTranslations, type Locale } from "@/utils/locale";
import { getCollection } from "astro:content";

const currentLocale = Astro.currentLocale as Locale;
const m = useTranslations(currentLocale);

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
// const breadcrumbList = currentUrlPath.split("/").slice(1);
const breadcrumbPathList = currentUrlPath.split("/").slice(2); // remove locale part
const breadcrumbLocalizedList = [...breadcrumbPathList];

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (breadcrumbPathList[0] === "posts") {
  breadcrumbLocalizedList[0] = m.text_posts();
  const page = Number(breadcrumbLocalizedList[1]) || 1;
  breadcrumbLocalizedList.splice(
    0,
    2,
    page === 1 ? m.text_posts() : m.text_posts_pagination({ page })
  );
  breadcrumbPathList.splice(0, 2, "posts");
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
let tagName = "";
if (breadcrumbPathList[0] === "tags") {
  breadcrumbLocalizedList[0] = m.text_tags();
  const allPosts = await getCollection("blog");
  const posts = getPostsByLocale(allPosts, currentLocale);
  const tags = getUniqueTags(posts);
  const tagFromUrl = breadcrumbPathList[1]
    ? decodeURIComponent(breadcrumbPathList[1])
    : "";
  if (tagFromUrl) {
    tagName = tags.filter(t => t.tag === tagFromUrl)[0]?.tagName || tagFromUrl;
  }
  const page = Number(breadcrumbLocalizedList[2]);
  if (!isNaN(page)) {
    tagName = page === 1 ? tagName : m.text_tags_pagination({ tagName, page });
    breadcrumbLocalizedList.splice(1, 3, tagName);
    breadcrumbPathList.splice(1, 3, tagFromUrl);
  }
}

if (breadcrumbLocalizedList[0] === "archives") {
  breadcrumbLocalizedList[0] = m.text_archives();
}

if (breadcrumbLocalizedList[0] === "search") {
  breadcrumbLocalizedList[0] = m.text_search();
}

if (breadcrumbLocalizedList[0] === "about") {
  breadcrumbLocalizedList[0] = m.text_about();
}
---

<nav class="app-layout mt-8 mb-1" aria-label={m.text_breadcrumb()}>
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={getLocalizedUrl(currentLocale, "/")} class="opacity-80"
        >{m.btn_home_title()}</a
      >
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbLocalizedList.map((breadcrumb, index) =>
        index + 1 === breadcrumbLocalizedList.length ? (
          <li>
            <span class:list={"opacity-75"} aria-current="page">
              {tagName || decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a
              href={getLocalizedUrl(
                currentLocale,
                `/${breadcrumbPathList[index]}/`
              )}
              class="capitalize opacity-70"
            >
              {breadcrumb}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
