---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="tw:flex tw:flex-none tw:flex-col tw:items-center tw:justify-center tw:gap-1 tw:md:items-start">
      <span class="tw:italic">Share this post on:</span>
      <div class="tw:text-center">
        {SHARE_LINKS.map(social => (
          <LinkButton
            href={`${social.href + URL}`}
            class="tw:scale-90 tw:p-2 tw:hover:rotate-6 tw:sm:p-1"
            title={social.linkTitle}
          >
            <social.icon class="tw:inline-block tw:size-6 tw:scale-125 tw:fill-transparent tw:stroke-current tw:stroke-2 tw:opacity-90 tw:group-hover:fill-transparent tw:sm:scale-110" />
            <span class="tw:sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}
