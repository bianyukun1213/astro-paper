---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["tw:app-layout", { "tw:mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "tw:py-6 tw:sm:py-4",
      "tw:border-t tw:border-border",
      "tw:flex tw:flex-col tw:items-center tw:justify-between tw:sm:flex-row-reverse",
    ]}
  >
    <Socials />
    <div class="tw:my-2 tw:flex tw:flex-col tw:items-center tw:whitespace-nowrap tw:sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="tw:hidden tw:sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
  </div>
</footer>
