---
import "photoswipe/style.css";
---

<script>
  import type { AlpineStoreImages } from "@/utils/types";
import PhotoSwipe from "photoswipe";
  const figureClassName = ".tide-image-figure";
  function initImageViewer() {
    const imageFigures = [
      ...document.querySelectorAll<HTMLElement>(figureClassName),
    ];
    if (imageFigures.length === 0) return;
    const container =
      document.getElementById("article") ??
      document.getElementById("main-content") ??
      document.body;
    const openViewer = (index: number) => {
      const dataSource = imageFigures
        .map(figure => {
          const img = figure.querySelector("img");
          if (!img) return null;
          const maskTitle = figure.dataset.mask;
          const imageId = figure.dataset.imageId || "";
          const hasMask = !!maskTitle;
          const isRevealed = figure.dataset.revealed === "true";
          return {
            src: img.src,
            width:
              parseInt(img.getAttribute("width") as string, 10) ||
              img.naturalWidth ||
              1920,
            height:
              parseInt(img.getAttribute("height") as string, 10) ||
              img.naturalHeight ||
              1080,
            alt: img.alt,
            imageId,
            caption: img.dataset.caption || img.title,
            hasMask,
            maskTitle,
            isRevealed,
            originalElement: figure,
          };
        })
        .filter(item => item !== null);
      const pswp = new PhotoSwipe({
        dataSource: dataSource,
        index: index,
        closeTitle: window.m.btn_pswp_close_title(),
        zoomTitle: window.m.btn_pswp_zoom_title(),
        arrowPrevTitle: window.m.btn_pswp_arrow_prev_title(),
        arrowNextTitle: window.m.btn_pswp_arrow_next_title(),
        errorMsg: window.m.text_pswp_error_msg(),
        indexIndicatorSep: window.m.text_pswp_index_indicator_sep(),
      });
      pswp.on("uiRegister", () => {
        if (!pswp.ui) return;
        pswp.ui.registerElement({
          name: "reveal", // PhotoSwipe 会自动生成 class: pswp__button--reveal。
          order: 8,
          isButton: true,
          title: window.m.btn_pswp_reveal_title(),
          html: '<svg aria-hidden="true" class="pswp__icn" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-icon lucide-eye"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>',
          onClick: (event, el, pswpInstance) => {
            if (!pswpInstance.currSlide) return;
            const currData = pswpInstance.currSlide.data;
            currData.isRevealed = true;
            if (window.Alpine) {
              (window.Alpine.store("images") as AlpineStoreImages).reveal(
                currData.imageId
              );
            }
            updateViewerState(pswpInstance);
          },
        });
        pswp.ui.registerElement({
          name: "caption",
          order: 9,
          isButton: true,
          title: window.m.btn_pswp_caption_title(),
          html: '<svg aria-hidden="true" class="pswp__icn" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-captions-icon lucide-captions"><rect width="18" height="14" x="3" y="5" rx="2" ry="2"/><path d="M7 15h4M15 15h2M7 11h2M13 11h4"/></svg>',
          appendTo: "bar",
          onClick: (event, el, pswpInstance) => {
            if (!pswpInstance.currSlide) return;
            const currData = pswpInstance.currSlide.data;
            alert(currData.caption);
          },
        });
        pswp.ui.registerElement({
          name: "image-mask",
          isButton: false,
          html: '<div class="pswp__image-mask-title"></div>',
          appendTo: "wrapper",
          onInit: el => {
            const stopSwipe = (e: Event) => e.stopPropagation();
            el.addEventListener("pointerdown", stopSwipe);
            el.addEventListener("mousedown", stopSwipe);
            el.addEventListener("touchstart", stopSwipe);
          },
        });
        pswp.ui.registerElement({
          name: "image-caption-container",
          isButton: false,
          html: '<div class="pswp__image-caption"></div>',
          appendTo: "root",
        });
      });
      const updateViewerState = (pswpInstance: PhotoSwipe) => {
        if (!pswpInstance.currSlide) return;
        const currData = pswpInstance.currSlide.data;
        const rootEl = pswpInstance.element;
        if (!rootEl) return;
        const container =
          rootEl.querySelector<HTMLDivElement>(".pswp__container");
        const btnReveal = rootEl.querySelector<HTMLButtonElement>(
          ".pswp__button--reveal"
        );
        const mask = rootEl.querySelector<HTMLDivElement>(".pswp__image-mask");
        const maskTitleEle = rootEl.querySelector<HTMLDivElement>(
          ".pswp__image-mask-title"
        );
        const btnCaption = rootEl.querySelector<HTMLButtonElement>(
          ".pswp__button--caption"
        );
        const captionBox = rootEl.querySelector<HTMLDivElement>(
          ".pswp__image-caption"
        );
        if (currData.hasMask && !currData.isRevealed) {
          if (btnReveal) btnReveal.classList.remove("tide-dynamic-hidden");
          if (container && mask && maskTitleEle) {
            container.classList.add("tide-dynamic-hidden");
            mask.classList.add("pswp__image-masked");
            maskTitleEle.innerText =
              currData.maskTitle || window.m.text_tide_picture_default_mask();
          }
        } else {
          if (btnReveal) btnReveal.classList.add("tide-dynamic-hidden");
          if (container && mask && maskTitleEle) {
            container.classList.remove("tide-dynamic-hidden");
            mask.classList.remove("pswp__image-masked");
            maskTitleEle.innerText = "";
          }
        }
        if (currData.caption) {
          if (btnCaption) btnCaption.classList.remove("tide-dynamic-hidden");
          if (captionBox) {
            captionBox.innerHTML = currData.caption;
            captionBox.classList.remove("tide-dynamic-hidden");
          }
        } else {
          if (btnCaption) btnCaption.classList.add("tide-dynamic-hidden");
          if (captionBox) captionBox.classList.add("tide-dynamic-hidden");
        }
      };
      pswp.on("change", () => updateViewerState(pswp));
      pswp.init();
    };
    const handleInteraction = (e: Event, figure: HTMLElement) => {
      if (figure.dataset.revealed !== "true") return;
      e.preventDefault();
      const index = imageFigures.indexOf(figure);
      if (index !== -1) openViewer(index);
    };
    container.addEventListener("click", (e: MouseEvent) => {
      if ((e.target as HTMLElement).classList.contains("tide-image")) {
        const figure = (e.target as HTMLElement).closest(
          figureClassName
        ) as HTMLElement;
        handleInteraction(e, figure);
      }
    });
    container.addEventListener("keydown", (e: KeyboardEvent) => {
      if (
        (e.target as HTMLElement).classList.contains("tide-image") &&
        (e.key === "Enter" || e.key === " ")
      ) {
        const figure = (e.target as HTMLElement).closest(
          figureClassName
        ) as HTMLElement;
        handleInteraction(e, figure);
      }
    });
  }
  document.addEventListener("astro:page-load", () => {
    initImageViewer();
  });
</script>
