---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="tw:absolute tw:start-16 tw:-top-full tw:z-50 tw:bg-background tw:px-3 tw:py-2 tw:text-accent tw:backdrop-blur-lg tw:transition-all tw:focus:top-4"
>
  Skip to content
</a>

<header
  class="tw:app-layout tw:flex tw:flex-col tw:items-center tw:justify-between tw:sm:flex-row"
>
  <div
    id="top-nav-wrap"
    class:list={[
      "tw:py-4 tw:sm:py-6",
      "tw:border-b tw:border-border",
      "tw:relative tw:w-full tw:bg-background",
      "tw:flex tw:items-baseline tw:justify-between tw:sm:items-center",
    ]}
  >
    <a
      href="/"
      class="tw:absolute tw:py-1 tw:text-xl tw:leading-8 tw:font-semibold tw:whitespace-nowrap tw:sm:static tw:sm:my-auto tw:sm:text-2xl tw:sm:leading-none"
    >
      {SITE.title}
    </a>
    <nav
      id="nav-menu"
      class="tw:flex tw:w-full tw:flex-col tw:items-center tw:sm:ms-2 tw:sm:flex-row tw:sm:justify-end tw:sm:space-x-4 tw:sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline tw:self-end tw:p-2 tw:sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="tw:hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "tw:mt-4 tw:grid tw:w-44 tw:grid-cols-2 tw:place-content-center tw:gap-2",
          "tw:[&>li>a]:block tw:[&>li>a]:px-4 tw:[&>li>a]:py-3 tw:[&>li>a]:text-center tw:[&>li>a]:font-medium tw:[&>li>a]:hover:text-accent tw:sm:[&>li>a]:px-2 tw:sm:[&>li>a]:py-1",
          "tw:hidden",
          "tw:sm:mt-0 tw:sm:flex tw:sm:w-auto tw:sm:gap-x-5 tw:sm:gap-y-0",
        ]}
      >
        <li class="tw:col-span-2">
          <a href="/posts" class:list={{ "active-nav": isActive("/posts") }}>
            Posts
          </a>
        </li>
        <li class="tw:col-span-2">
          <a href="/tags" class:list={{ "active-nav": isActive("/tags") }}>
            Tags
          </a>
        </li>
        <li class="tw:col-span-2">
          <a href="/about" class:list={{ "active-nav": isActive("/about") }}>
            About
          </a>
        </li>
        {
          SITE.showArchives && (
            <li class="tw:col-span-2">
              <LinkButton
                href="/archives"
                class:list={[
                  "focus-outline tw:flex tw:justify-center tw:p-3 tw:sm:p-1",
                  {
                    "active-nav tw:[&>svg]:stroke-accent": isActive("/archives"),
                  },
                ]}
                title="Archives"
                aria-label="archives"
              >
                <IconArchive class="tw:hidden tw:sm:inline-block" />
                <span class="tw:sm:sr-only">Archives</span>
              </LinkButton>
            </li>
          )
        }
        <li class="tw:col-span-1 tw:flex tw:items-center tw:justify-center">
          <LinkButton
            href="/search"
            class:list={[
              "focus-outline tw:flex tw:p-3 tw:sm:p-1",
              { "tw:[&>svg]:stroke-accent": isActive("/search") },
            ]}
            title="Search"
            aria-label="search"
          >
            <IconSearch />
            <span class="tw:sr-only">Search</span>
          </LinkButton>
        </li>
        {
          SITE.lightAndDarkMode && (
            <li class="tw:col-span-1 tw:flex tw:items-center tw:justify-center">
              <button
                id="theme-btn"
                class="focus-outline tw:relative tw:size-12 tw:p-4 tw:sm:size-8 tw:hover:[&>svg]:stroke-accent"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="tw:absolute tw:top-[50%] tw:left-[50%] tw:-translate-[50%] tw:scale-100 tw:rotate-0 tw:transition-all tw:dark:scale-0 tw:dark:-rotate-90" />
                <IconSunHigh class="tw:absolute tw:top-[50%] tw:left-[50%] tw:-translate-[50%] tw:scale-0 tw:rotate-90 tw:transition-all tw:dark:scale-100 tw:dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("tw:hidden");
      menuIcon.classList.toggle("tw:hidden");
      closeIcon.classList.toggle("tw:hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
