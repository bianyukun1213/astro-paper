---
import IconUser from "@/assets/icons/IconUser.svg";
import { useTranslations, type Locale } from "@/utils/locale";
import type { HCard as HCardType } from "@/utils/types";
import HCard from "./HCard.astro";

const currentLocale = Astro.currentLocale as Locale;
const m = useTranslations(currentLocale);

type Props = {
  author: string;
  hCard: HCardType;
  class?: string;
  size?: "sm" | "lg";
};

const { author, hCard, size = "sm", class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-x-2 opacity-80", className]}>
  <IconUser
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
    {m.text_author()}
  </span>
  <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    >{author}</span
  >
  <HCard {hCard} />
</div>
