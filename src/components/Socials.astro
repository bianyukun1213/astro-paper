---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="tw:flex tw:flex-wrap tw:items-center tw:gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="tw:p-2 tw:hover:rotate-6 tw:sm:p-1"
        title={social.linkTitle}
      >
        <social.icon class="tw:inline-block tw:size-6 tw:scale-125 tw:fill-transparent tw:stroke-current tw:stroke-2 tw:opacity-90 tw:group-hover:fill-transparent tw:sm:scale-110" />
        <span class="tw:sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>
