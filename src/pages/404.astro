---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="tw:app-layout tw:flex tw:flex-1 tw:items-center tw:justify-center"
  >
    <div class="tw:mb-14 tw:flex tw:flex-col tw:items-center tw:justify-center">
      <h1 class="tw:text-9xl tw:font-bold tw:text-accent">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="tw:mt-4 tw:text-2xl tw:sm:text-3xl">Page Not Found</p>
      <LinkButton
        href="/"
        class="tw:my-6 tw:text-lg tw:underline tw:decoration-dashed tw:underline-offset-8"
      >
        Go back home
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
