---
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { getPostsByLocale } from "@/utils/getPostsByLocale";
import getPostsByTag from "@/utils/getPostsByTag";
import getUniqueTags from "@/utils/getUniqueTags";
import {
getLocaleFromFilePath,
getLocales,
useTranslations,
type Locale,
} from "@/utils/locale";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection("blog");
  const localesInUse = [
    ...new Set(allPosts.map(post => getLocaleFromFilePath(post.filePath))),
  ];
  return localesInUse.flatMap(locale => {
    const localePosts = getPostsByLocale(allPosts, locale);
    const tags = getUniqueTags(localePosts, locale);
    return tags.flatMap(({ tag, tagName }) => {
      const tagPosts = getPostsByTag(localePosts, tag);
      return paginate(tagPosts, {
        params: { locale, tag },
        props: { tagName },
        pageSize: SITE.postPerPage,
      });
    });
  });
}) satisfies GetStaticPaths;
const currentLocale = Astro.currentLocale as Locale;
const m = useTranslations(currentLocale);

const { tag } = Astro.params;
const { page, tagName } = Astro.props;

const availableLocales: Locale[] = [];
const allPosts = await getCollection("blog");
const postsByTag = getPostsByTag(allPosts, tag);
const locales = getLocales();
for (const locale of locales) {
  const postsByTagAndLocale = getPostsByLocale(postsByTag, locale);
  const postsByTagAndLocaleCount = postsByTagAndLocale.length;
  const pagesCount = Math.ceil(postsByTagAndLocaleCount / page.size);
  if (pagesCount >= page.currentPage) {
    availableLocales.push(locale);
  }
}

Astro.locals.localesOverride = availableLocales;
---

<Layout title={`${m.text_tags_tag({ tagName })} | ${m.site_title()}`}>
  <Header />
  <Main
    pageTitle={m.text_tags_tag({ tagName })}
    pageDesc={m.text_tags_tag_desc({ tagName })}
  >
    <h1 slot="title">{m.text_tags_tag({ tagName })}</h1>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
