---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Tag from "@/components/Tag.astro";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { getPostsByLocale } from "@/utils/getPostsByLocale";
import getUniqueTags from "@/utils/getUniqueTags";
import { getLocales, getLocalizedSite, useTranslations, type Locale } from "@/utils/locale";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async () => {
  const locales = getLocales();
  return locales.map(locale => ({
    params: { locale },
  }));
}) satisfies GetStaticPaths;
const currentLocale = Astro.currentLocale as Locale;
const m = useTranslations(currentLocale);
const localSite = getLocalizedSite(currentLocale);

const allPosts = await getCollection("blog");
const posts = getPostsByLocale(allPosts, currentLocale);

let tags = getUniqueTags(posts);
---

<Layout title={`Tags | ${localSite.title}`}>
  <Header />
  <Main pageTitle="Tags" pageDesc="All the tags used in posts.">
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
