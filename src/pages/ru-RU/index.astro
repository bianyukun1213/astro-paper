---
import IconRss from "@/assets/icons/IconRss.svg";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import { getLocalizedSocials } from "@/constants";
import IndexLayout from "@/layouts/IndexLayout.astro";
import {
type Locale,
getLocales,
getLocalizedUrl,
useTranslations,
} from "@/utils/locale";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const locales = getLocales();
  return locales.map(locale => ({
    params: { locale },
  }));
}) satisfies GetStaticPaths;
const currentLocale = Astro.currentLocale as Locale;
const m = useTranslations(currentLocale);
const socialLinks = getLocalizedSocials(currentLocale);
---

<IndexLayout>
  <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
    <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
      Mingalaba
    </h1>
    <a
      target="_blank"
      href={getLocalizedUrl(currentLocale, "/rss.xml").slice(0, -1)}
      class="inline-block"
      aria-label={m.btn_rss_title()}
      title={m.btn_rss_title()}
    >
      <IconRss
        width={20}
        height={20}
        class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
      />
      <span class="sr-only">{m.btn_rss_title()}</span>
    </a>

    <p>
      AstroPaper — это минималистичная, адаптивная, доступная и
      SEO-оптимизированная тема блога на платформе Astro. Эта тема соответствует
      лучшим практикам веб-разработки и обеспечивает доступность «из коробки».
      По умолчанию поддерживаются светлый и темный режимы; кроме того, можно
      настроить дополнительные цветовые схемы.
    </p>
    <p class="mt-2">
      Читайте блог или смотрите
      <LinkButton
        class="underline decoration-dashed underline-offset-4 hover:text-accent"
        href="https://github.com/satnaing/astro-paper#readme"
      >
        README
      </LinkButton> для получения дополнительной информации.
    </p>
    {
      // only display if at least one social link is enabled
      socialLinks.length > 0 && (
        <div class="mt-4 flex max-sm:flex-col sm:items-center">
          <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
            Социальные ссылки:
          </div>
          <Socials />
        </div>
      )
    }
  </section>
</IndexLayout>
