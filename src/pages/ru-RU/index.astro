---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { getLocalizedSocials } from "@/socials";
import {
  type Locale,
  getLocales,
  getLocalizedUrl,
  useTranslations,
} from "@/utils/locale";
import type { GetStaticPaths } from "astro";
import { getPostsByLocale } from "@/utils/getPostsByLocale";

export const getStaticPaths = (async () => {
  const locales = getLocales();
  return locales.map(locale => ({
    params: { locale },
  }));
}) satisfies GetStaticPaths;
const currentLocale = Astro.currentLocale as Locale;
const m = useTranslations(currentLocale);
const socialLinks = getLocalizedSocials(currentLocale);

const allPosts = await getCollection("blog");
const posts = getPostsByLocale(allPosts, currentLocale);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Mingalaba
      </h1>
      <a
        target="_blank"
        href={getLocalizedUrl(currentLocale, "/rss.xml").slice(0, -1)}
        class="inline-block"
        aria-label={m.btn_rss_title()}
        title={m.btn_rss_title()}
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">{m.btn_rss_title()}</span>
      </a>

      <p>
        AstroPaper — это минималистичная, адаптивная, доступная и
        SEO-оптимизированная тема блога на платформе Astro. Эта тема
        соответствует лучшим практикам веб-разработки и обеспечивает доступность
        «из коробки». По умолчанию поддерживаются светлый и темный режимы; кроме
        того, можно настроить дополнительные цветовые схемы.
      </p>
      <p class="mt-2">
        Читайте блог или смотрите
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://github.com/satnaing/astro-paper#readme"
        >
          README
        </LinkButton> для получения дополнительной информации.
      </p>
      {
        // only display if at least one social link is enabled
        socialLinks.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              Социальные ссылки:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {m.text_featured_posts()}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {m.text_recent_posts()}
          </h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getLocalizedUrl(currentLocale, "/posts/")}>
        {m.btn_all_posts_title()}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    const locale = window.location.pathname.split("/")[1];
    if (indexLayout) {
      sessionStorage.setItem("backUrl", locale ? `/${locale}/` : "/");
    }
  });
</script>
